    {
      "name": "4. Patient-Doctor Mapping APIs",
      "item": [
        {
          "name": "4.1 Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.mapping && jsonData.mapping.id) {",
                  "    pm.collectionVariables.set('mapping_id', jsonData.mapping.id);",
                  "    if (pm.environment) {",
                  "        pm.environment.set('mapping_id', jsonData.mapping.id);",
                  "    }",
                  "    console.log('Saved mapping_id:', jsonData.mapping.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
