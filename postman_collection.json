{
  "info": {
    "_postman_id": "7f8b9e61-34a2-4a7b-a112-9c1234567890",
    "name": "Healthcare Backend API - Complete Collection",
    "description": "Comprehensive Postman collection for the Healthcare Backend System built with Django, Django REST Framework, PostgreSQL, and SimpleJWT.\n\n### How to use:\n1. Import this file into Postman.\n2. Run **1.1 Register User** or **1.2 Login User**.\n3. The test scripts automatically store the JWT Bearer token into `{{token}}` collection variable.\n4. All subsequent Patient, Doctor, and Mapping requests will use `{{token}}` automatically!\n5. Dynamic IDs (`{{patient_id}}`, `{{doctor_id}}`, `{{mapping_id}}`) are also auto-updated upon creation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "mapping_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication APIs",
      "item": [
        {
          "name": "1.1 Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "    if (pm.environment) {",
                  "        pm.environment.set('token', jsonData.tokens.access);",
                  "        pm.environment.set('refresh_token', jsonData.tokens.refresh);",
                  "    }",
                  "    console.log('JWT Token auto-saved to variables!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. John Watson\",\n  \"email\": \"john.watson@hospital.com\",\n  \"password\": \"MedicalPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "POST /api/auth/register/ - Register a new user with name, email, and password."
          }
        },
        {
          "name": "1.2 Login User (Obtain JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "    if (pm.environment) {",
                  "        pm.environment.set('token', jsonData.access);",
                  "        pm.environment.set('refresh_token', jsonData.refresh);",
                  "    }",
                  "    console.log('JWT Access Token saved successfully!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.watson@hospital.com\",\n  \"password\": \"MedicalPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "POST /api/auth/login/ - Log in a user and return a JWT access and refresh token."
          }
        },
        {
          "name": "1.3 Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "    if (pm.environment) {",
                  "        pm.environment.set('token', jsonData.access);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "description": "POST /api/auth/token/refresh/ - Generate a fresh access token using a refresh token."
          }
        },
        {
          "name": "1.4 Get User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile", ""]
            },
            "description": "GET /api/auth/profile/ - Retrieve details of currently logged in user."
          }
        }
      ]
    },
